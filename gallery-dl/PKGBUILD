# Ported from the AUR gallery-dl package (maintainer katt
# <magunasu.b97@gmail.com>, contributor LLL2yu <lll2yu@protonmail.com>).

pkgname=gallery-dl
pkgver=1.32.19
pkgrel=1
pkgdesc='Command-line program to download image galleries and collections from several image hosting sites'
arch=('any')
url='https://codeberg.org/mikf/gallery-dl'
license=('GPL-2.0-or-later')
depends=('python' 'python-requests')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('yt-dlp')
# Pure Python: there are no binaries to split debug symbols from.
options=('!debug')
optdepends=(
    'ffmpeg: Pixiv Ugoira conversion'
    'mkvtoolnix-cli: accurate Ugoira frame timecodes'
    'python-brotli: Brotli compression support'
    'python-brotlicffi: Brotli compression support'
    'python-jinja: Jinja template support'
    'python-psycopg: PostgreSQL support'
    'python-pysocks: SOCKS proxy support'
    'python-secretstorage: GNOME keyring passwords for --cookies-from-browser'
    'python-truststore: use system certificates'
    'python-yaml: YAML configuration file support'
    'python-zstandard: Zstandard compression support'
    'yt-dlp: HLS/DASH video downloads, ytdl integration'
)
source=("git+${url}.git#tag=v${pkgver}?signed")
validpgpkeys=('3E09F5908333DD83DBDCE7375680CA389D365A88') # Mike Fährmann
sha512sums=('ce970ee81d7cacc6a3a9617e30e74166404cbddcae13316baa6a7101b22527f4536054daa4a9f65fb2c5de1e60cc5608258ca04aab22b68161a37c914e99d3b0')

build() {
    cd "${pkgname}"
    make
    python -m build --wheel --no-isolation
}

check() {
    make -C "${pkgname}" test
}

package() {
    cd "${pkgname}"
    python -m installer --destdir="${pkgdir}" dist/*.whl
    install -Dm644 -t "${pkgdir}/usr/share/doc/${pkgname}" \
        docs/{configuration.rst,formatting.md,gallery-dl-example.conf} CHANGELOG.md
}
