# Repackages T3 Tools' official Debian package from GitHub Releases. Only the
# .deb's file payload is used; its maintainer scripts do Debian-specific work
# (update-alternatives, an AppArmor profile for Ubuntu), and the parts that
# matter on Arch are reproduced in package().

pkgname=t3code-bin
pkgver=0.1.12
pkgrel=1
pkgdesc='Desktop GUI for coding agents (Claude Code, Codex, and more)'
arch=('x86_64')
url='https://t3.codes'
license=('MIT')
provides=('t3code')
conflicts=('t3code')
# The .deb's Depends translated to Arch names, plus libraries the shipped
# Electron and helper binaries link directly.
depends=(
    'alsa-lib'
    'at-spi2-core'
    'cairo'
    'dbus'
    'expat'
    'gcc-libs'
    'glib2'
    'glibc'
    'gtk3'
    'hicolor-icon-theme'
    'libcups'
    'libdrm'
    'libnotify'
    'libsecret'
    'libx11'
    'libxcb'
    'libxcomposite'
    'libxdamage'
    'libxext'
    'libxfixes'
    'libxkbcommon'
    'libxrandr'
    'libxss'
    'libxtst'
    'mesa'
    'nspr'
    'nss'
    'pango'
    'systemd-libs'
    'util-linux-libs'
    'xdg-utils'
)
optdepends=(
    'gnome-keyring: credential storage via Secret Service (GNOME)'
    'kwallet: credential storage (KDE Plasma)'
    'libayatana-appindicator: system tray icon'
    'xdg-desktop-portal: native file dialogs and desktop integration'
)
# Stripping prebuilt Electron binaries can corrupt embedded resources and
# saves nothing; there is nothing to build a -debug package from.
options=('!strip' '!debug')
source=(
    't3code.sh'
    "https://github.com/pingdotgg/t3code/releases/download/v${pkgver}/T3-Code-${pkgver}-amd64.deb"
)
sha256sums=('24dff1b246b9e3979d06e4a3ba8165b99c20ead2d3efb6838c3cabbac61881de'
            'c1ca3e656e12ba10377513e9bbe20a5112540cda9601e21c70b85ba7c53f1b29')

package() {
    # makepkg unpacks the .deb (an ar archive); data.tar.xz is the payload.
    rm -rf root
    mkdir root
    bsdtar -xf data.tar.xz -C root

    local -a appdirs=(root/opt/*)
    if (( ${#appdirs[@]} != 1 )) || [[ ! -x ${appdirs[0]}/t3code ]]; then
        error "Unexpected /opt layout in .deb; re-audit"
        return 1
    fi

    install -d "${pkgdir}/usr/lib"
    cp -a "${appdirs[0]}" "${pkgdir}/usr/lib/t3code"
    cp -a root/usr/share "${pkgdir}/usr/share"

    # The launcher selects the Wayland backend and reads
    # ~/.config/t3code-flags.conf.
    install -Dm755 t3code.sh "${pkgdir}/usr/bin/t3code"
    sed -i 's|^Exec=.*|Exec=t3code %U|' \
        "${pkgdir}/usr/share/applications/t3code.desktop"

    install -Dm644 "${pkgdir}/usr/share/doc/t3code/copyright" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    rm -rf "${pkgdir}/usr/share/doc"
}
